{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/eval_subject_gate.py",
            "statusMessage": "Checking benchmark isolation",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.rs) rustfmt \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting Rust"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/clippy_edit.sh",
            "statusMessage": "Checking clippy",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify_gate.sh",
            "statusMessage": "Running gate (ci.sh --fast)",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
